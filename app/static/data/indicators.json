    "reason_hb_fulfilment": {
      "section": "transfusions",
      "table": "transfusions",
      "label": "Mean haemoglobin vs fulfilment rate, by reason for transfusion",
      "kind": "scatter",
      "unit": "",
      "axis": "",
      "description": "Each point is one reason for transfusion: average Hb against the fulfilment rate.",
      "measures": [
        {
          "key": "hb",
          "label": "Mean Hb at request (g/dL)",
          "unit": "g/dL"
        },
        {
          "key": "rate",
          "label": "Fulfilment rate (%)",
          "unit": "%"
