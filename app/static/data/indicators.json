        {
          "key": "units",
          "label": "Units received"
        }
      ],
      "dims": [
        "channel",
        "blood_group",
        "screening",
        "discard_reason"
      ],
      "default_by": "channel"
    },
    "components": {
      "section": "processing",
      "table": "processing",
      "label": "Blood components produced",
      "unit": "components",
      "axis": "Components",
