    "facility_returns": {
      "section": "distribution",
      "table": "distributions",
      "label": "Units received vs share returned unused, by hospital",
      "kind": "scatter",
      "unit": "",
      "axis": "",
      "description": "Each point is one hospital: units received against the share of orders returned unused.",
      "measures": [
        {
          "key": "units",
          "label": "Units distributed",
          "unit": "units"
