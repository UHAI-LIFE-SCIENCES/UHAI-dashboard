    "mean_hb": {
      "section": "transfusions",
      "table": "transfusions",
      "label": "Mean haemoglobin at request",
      "unit": "g/dL",
      "axis": "Hb (g/dL)",
      "ratio": true,
      "description": "Average haemoglobin (Hb) when blood was requested.",
      "measures": [
        {
          "key": "hb",
          "label": "Mean Hb"
