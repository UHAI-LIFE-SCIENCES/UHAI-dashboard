      "section": "processing",
      "table": "processing",
      "label": "Reactive TTI screening results (share)",
      "unit": "%",
      "axis": "% of units",
      "ratio": true,
      "description": "Share of units with a reactive infection screen. A reactive screen is not a confirmed infection.",
