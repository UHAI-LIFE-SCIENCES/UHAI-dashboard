        "month",
        "week",
        "facility",
        "product",
        "status"
      ],
      "default_by": "facility"
    },
    "orders": {
      "section": "distribution",
      "table": "distributions",
      "label": "Distribution orders",
      "unit": "orders",
      "axis": "Orders",
      "description": "Number of hospital orders. One order can include several units.",
      "measures": [
        {
          "key": "orders",
          "label": "Orders"
        }
      ],
      "dims": [
        "month",
        "week",
        "facility",
        "product",
        "status",
        "turnaround"
      ],
      "default_by": "month"
    },
    "mean_turnaround": {
      "section": "distribution",
      "table": "distributions",
      "label": "Mean order-to-receipt time",
      "unit": "days",
      "axis": "Days",
      "ratio": true,
      "description": "Average days from a hospital ordering blood to receiving it.",
      "measures": [
        {
          "key": "days",
