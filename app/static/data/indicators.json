        {
          "key": "returned",
          "label": "Orders returned unused (%)",
          "unit": "%"
        }
      ],
      "dims": [
        "facility"
      ],
      "default_by": "facility"
    },
    "requests": {
      "section": "transfusions",
      "table": "transfusions",
      "label": "Transfusion requests",
      "unit": "requests",
      "axis": "Requests",
      "description": "Number of patient transfusion requests.",
      "measures": [
        {
          "key": "requests",
          "label": "Requests"
