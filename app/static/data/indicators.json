      "default_by": "collection"
    },
    "volume_donated": {
      "section": "sourcing",
      "table": "sourcing",
      "label": "Volume of blood donated",
      "unit": "litres",
      "axis": "Litres",
      "description": "Total blood donated, in litres.",
      "measures": [
        {
          "key": "volume",
          "label": "Volume (L)"
