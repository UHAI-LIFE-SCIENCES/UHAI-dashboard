        {
          "key": "share",
          "label": "Reactive share"
        }
      ],
      "dims": [
        "channel",
        "blood_group"
      ],
      "default_by": "channel"
    },
    "discard_share": {
      "section": "processing",
      "table": "processing",
      "label": "Units discarded (share)",
      "unit": "%",
      "axis": "% of units",
      "ratio": true,
      "description": "Share of units discarded for any reason.",
      "measures": [
        {
          "key": "share",
          "label": "Discarded share"
        }
      ],
      "dims": [
        "channel",
        "blood_group"
      ],
      "default_by": "channel"
    },
    "units_distributed": {
      "section": "distribution",
      "table": "distributions",
      "label": "Units distributed to hospitals",
      "unit": "units",
      "axis": "Units",
      "description": "Units of blood sent to hospitals.",
