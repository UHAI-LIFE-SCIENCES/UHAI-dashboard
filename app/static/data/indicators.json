      ],
      "dims": [
        "month",
        "week",
        "blood_group",
        "collection",
        "donor_type"
      ],
      "default_by": "month"
    },
    "voluntary_share": {
      "section": "sourcing",
      "table": "sourcing",
      "label": "Voluntary donations (share)",
      "unit": "%",
      "axis": "% of donations",
      "ratio": true,
      "description": "Share of donations from voluntary donors rather than family or replacement donors.",
      "measures": [
        {
          "key": "share",
          "label": "Voluntary share"
        }
      ],
      "dims": [
        "month",
        "week",
        "blood_group",
        "collection",
        "sex",
        "age_group"
      ],
      "default_by": "month"
    },
    "units_received": {
      "section": "processing",
      "table": "processing",
      "label": "Donated units received for processing",
      "unit": "units",
      "axis": "Units",
      "description": "Donated units received for testing and processing. These records are not dated.",
